RUNNER_IMAGE=ghcr.io/{{ runner_github_org }}/infra-runner:verified
DOCKER_HOST=tcp://controller-proxy:2375
GITHUB_ORG={{ runner_github_org }}
GITHUB_TOKEN=
GITHUB_APP_ID={{ uye_deploy_runner_github_app.app_id }}
GITHUB_APP_INSTALLATION_ID={{ uye_deploy_runner_github_app.installation_id }}
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key
RUNNER_LABELS={{ uye_deploy_runner_labels }}
DESIRED_IDLE={{ uye_deploy_runner_desired_idle }}
RUNNER_MEMORY={{ uye_deploy_runner_memory }}
RUNNER_RUNTIME={{ uye_deploy_runner_runtime }}
RUNNER_KATA_DNS={{ uye_deploy_runner_kata_dns }}
RUNNER_CPUS={{ uye_deploy_runner_cpus }}
RUNNER_KANIKO_SIZE={{ uye_deploy_runner_kaniko_size }}
RUNNER_APPARMOR_PROFILE={{ uye_deploy_runner_apparmor_profile }}
RUNNER_SECCOMP_HOST_PATH=/etc/uye-deploy/runner-profile.json
CONTROLLER_POLL_INTERVAL={{ uye_deploy_runner_controller_poll_interval }}
