# Generated by Ansible – do not edit manually.
# ── GitHub credentials ─────────────────────────────────────────────────────────
# GITHUB_TOKEN is intentionally absent — the controller authenticates via
# GitHub App and manages token generation/refresh internally.
GITHUB_APP_ID={{ runner_github_app.app_id }}
GITHUB_APP_INSTALLATION_ID={{ runner_github_app.installation_id }}
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key
GITHUB_APP_PRIVATE_KEY_HOST_PATH={{ runner_github_app_key_dest }}
GITHUB_ORG={{ runner_github_org }}
GITHUB_REPO={{ runner_github_repo }}

# ── Runner pool ────────────────────────────────────────────────────────────────
RUNNER_LABELS={{ runner_labels }}
DESIRED_IDLE={{ runner_desired_idle }}
RUNNER_MEMORY={{ runner_memory }}
RUNNER_CPUS={{ runner_cpus }}
RUNNER_KANIKO_SIZE={{ runner_kaniko_size }}
RUNNER_RUNTIME={{ runner_runtime }}
RUNNER_KATA_DNS={{ runner_kata_dns }}

# ── Security hardening ─────────────────────────────────────────────────────────
RUNNER_APPARMOR_PROFILE={{ runner_apparmor_profile }}
RUNNER_SECCOMP_HOST_PATH={{ runner_repo_dest }}/seccomp/runner-profile.json

# ── GitOps deployer ────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME={{ runner_compose_project_name }}
POLL_INTERVAL={{ runner_poll_interval }}
HEALTH_PORT={{ runner_health_port }}
CONTROLLER_POLL_INTERVAL={{ runner_controller_poll_interval }}
