# Managed by Ansible. These paths are for the deployer container, which reads
# this .env at /workspace-edge and runs Compose from a different directory.
COMPOSE_FILE=/workspace-edge/docker-compose.yml:/workspace-edge/docker-compose.production.yml
CERTBOT_EMAIL={{ edge_cert_email }}
EDGE_CLOUDFLARE_CREDENTIALS_HOST_PATH={{ edge_credentials_path }}
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/live/edge-sites/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/live/edge-sites/privkey.pem
NGINX_SSL_CHAIN_PATH=/etc/nginx/ssl/live/edge-sites/chain.pem
NGINX_UPSTREAM_HOST=127.0.0.1
NGINX_UPSTREAM_PORT=8080
NGINX_LB_ALGORITHM=
NGINX_RATE_LIMIT_RATE=100r/m
NGINX_RATE_LIMIT_AUTH_RATE=10r/m
NGINX_RATE_LIMIT_GENERAL_RATE=200r/m
